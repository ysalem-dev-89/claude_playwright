# Only needed for the "AI (Stagehand)" fill strategy.
# Without this key, the demo still works fully in "Heuristic (no AI)" mode.
ANTHROPIC_API_KEY=

# Optional: override the model Stagehand uses for act()/extract() calls.
# STAGEHAND_MODEL=claude-3-7-sonnet-latest

# Optional: change the port the demo server listens on.
# PORT=3000

# --- WhatsApp -> Claude Code bridge (optional) ---
# Lets an allowlisted WhatsApp number drive a Claude Code session by text message.
# See README.md "Controlling Claude Code from WhatsApp" for full setup steps.

# From your Meta app's WhatsApp > API Setup page.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Any string you choose; must match what you enter in the Meta webhook config UI.
WHATSAPP_VERIFY_TOKEN=

# From your Meta app's Settings > Basic page; used to verify incoming webhook signatures.
WHATSAPP_APP_SECRET=

# Comma-separated, no "+", e.g. "15551234567,15559876543". REQUIRED to enable the
# bridge — messages from any other number are ignored. This grants shell/file access
# on this machine to every listed number, so keep it to your own phone.
WHATSAPP_ALLOWED_NUMBERS=

# Optional: directory (relative to the project root) Claude Code operates in when
# driven from WhatsApp. Defaults to ./whatsapp-workspace.
# WHATSAPP_WORKSPACE_DIR=whatsapp-workspace

# Optional: cap on agent turns per WhatsApp message, to bound runaway sessions.
# WHATSAPP_MAX_TURNS=40
